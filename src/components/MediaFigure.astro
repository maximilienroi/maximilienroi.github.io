---
import type { Media } from '../data/media';
import Photo from './Photo.astro';
import Video from './Video.astro';

interface Props {
  media: Media;
  sizes?: string;
  // In a section's media strip, every item has the same height.
  strip?: boolean;
}

const { media, sizes, strip = false } = Astro.props;
const meta = media.kind === 'video' ? media.poster : media.image;
const ratio = meta ? meta.width / meta.height : 1;
const style = strip ? `width: min(100%, calc(var(--strip) * ${ratio.toFixed(4)}));` : undefined;
---

<figure class:list={['media-figure', { 'media-figure--strip': strip }]} style={style}>
  {
    media.kind === 'video' ? (
      <Video src={media.src} poster={media.poster} label={media.alt} silent={media.silent} />
    ) : (
      <Photo image={media.image!} alt={media.alt} sizes={sizes} />
    )
  }
  {media.caption && <figcaption class="ui soft">{media.caption}</figcaption>}
</figure>

<style>
  .media-figure--strip {
    flex: 0 0 auto;
  }

  .media-figure--strip :global(.video) {
    max-width: none !important;
  }

  .media-figure figcaption {
    margin-top: 0.45rem;
    font-size: var(--step--1);
    line-height: 1.35;
  }
</style>
