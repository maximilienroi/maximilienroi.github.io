---
import type { Media } from '../data/media';
import Photo from './Photo.astro';
import Video from './Video.astro';

interface Props {
  media: Media;
  sizes?: string;
}

const { media, sizes } = Astro.props;
---

<figure class="media-figure">
  {
    media.kind === 'video' ? (
      <Video src={media.src} poster={media.poster} label={media.alt} />
    ) : (
      <Photo image={media.image!} alt={media.alt} sizes={sizes} />
    )
  }
  {media.caption && <figcaption class="ui soft">{media.caption}</figcaption>}
</figure>

<style>
  .media-figure figcaption {
    margin-top: 0.45rem;
    font-size: var(--step--1);
    line-height: 1.35;
  }
</style>
