---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Photo from './Photo.astro';
import MediaFigure from './MediaFigure.astro';
import { mediaFor } from '../data/media';
import { slug } from '../data/slug';

interface Props {
  items: CollectionEntry<'log'>[];
  lang: string;
  // On the community page only the first paragraph shows, with a link to the full text.
  excerpt?: boolean;
  more?: string;
}

const { items, lang, excerpt = false, more } = Astro.props;
const fmt = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : lang, {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const rows = await Promise.all(
  items.map(async (item) => ({ item, extra: mediaFor(item.data.title ?? ''), ...(await render(item)) })),
);
---

<ol class="log">
  {
    rows.map(({ item, extra, Content }) => (
      <li class="log-row" id={item.data.title ? slug(item.data.title) : undefined}>
        <time class="log-date ui soft" datetime={item.data.date.toISOString().slice(0, 10)}>
          {item.data.dateLabel ?? fmt.format(item.data.date).replace('Sept', 'Sep')}
        </time>
        <div class="log-main">
          {item.data.title && <h3 class="log-title">{item.data.title}</h3>}
          <div class="log-text">
            {excerpt ? <p>{(item.body ?? '').trim().split(/\n\s*\n/)[0]}</p> : <Content />}
            {excerpt && more && item.data.title && (item.body ?? '').trim().split(/\n\s*\n/).length > 1 && (
              <p class="log-more ui">
                <a href={`${more}#${slug(item.data.title)}`}>Read more about {item.data.title.replace(/:.*/, '')}</a>
              </p>
            )}
          </div>
          {item.data.link && (
            <a class="log-link ui" href={item.data.link.url}>
              {item.data.link.label}
            </a>
          )}
          {(item.data.image || extra.length > 0) && (
            <div class="log-media">
              {item.data.image && (
                <Photo image={item.data.image} alt={item.data.imageAlt ?? ''} sizes="(max-width: 36rem) 100vw, 32rem" />
              )}
              {extra.map((m) => (
                <MediaFigure media={m} sizes="(max-width: 36rem) 100vw, 32rem" />
              ))}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .log {
    max-width: none;
  }

  .log-row {
    display: grid;
    grid-template-columns: var(--dates) minmax(0, 1fr);
    column-gap: var(--entry-gap);
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .log-row:first-child {
    padding-top: 0;
  }

  .log-row:last-child {
    border-bottom: 0;
  }

  .log-date {
    padding-top: 0.42rem;
  }

  .log-main {
    max-width: 42rem;
  }

  .log-title {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 650;
    font-stretch: 108%;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .log-text {
    margin-top: 0.75rem;
    text-wrap: pretty;
  }

  .log-text :global(p + p) {
    margin-top: 0.6em;
  }

  .log-more {
    margin-top: 0.75rem;
    font-weight: 550;
  }

  .log-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 550;
  }

  .log-media {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    max-width: 32rem;
  }

  @media (max-width: 36rem) {
    .log-row {
      grid-template-columns: 1fr;
      row-gap: 0.35rem;
    }
    .log-date {
      padding-top: 0;
    }
  }
</style>
