---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster?: ImageMetadata;
  label: string;
}

const { src, poster, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Local files live in public/media/; full URLs are used as they are.
const url = /^https?:\/\//.test(src) ? src : `${base}${src.replace(/^\/?(public\/)?/, '')}`;
const posterImg = poster ? await getImage({ src: poster, width: 800, format: 'webp' }) : null;
---

<figure class="video">
  <video src={url} poster={posterImg?.src} muted loop playsinline preload="none" aria-label={label}></video>
  <button class="video-toggle ui" type="button" aria-pressed="false">Play</button>
</figure>

<script>
  // Plays on hover with a mouse, and on tap on a phone.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  for (const fig of document.querySelectorAll<HTMLElement>('.video')) {
    const video = fig.querySelector('video')!;
    const toggle = fig.querySelector<HTMLButtonElement>('.video-toggle')!;

    const sync = () => {
      const playing = !video.paused;
      toggle.textContent = playing ? 'Pause' : 'Play';
      toggle.setAttribute('aria-pressed', String(playing));
      fig.classList.toggle('is-playing', playing);
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);

    toggle.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    if (canHover) {
      fig.addEventListener('pointerenter', () => video.play());
      fig.addEventListener('pointerleave', () => video.pause());
    } else {
      video.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    }
  }
</script>

<style>
  .video {
    position: relative;
    border-radius: 3px;
    overflow: hidden;
    background: var(--wash);
  }

  .video video {
    width: 100%;
    height: auto;
  }

  .video-toggle {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: rgb(10 8 14 / 0.72);
    color: #edebf2;
    cursor: pointer;
    transition:
      opacity 200ms ease,
      transform 160ms var(--ease-out);
  }

  .video-toggle:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .video.is-playing .video-toggle {
      opacity: 0;
    }
    .video.is-playing:hover .video-toggle,
    .video-toggle:focus-visible {
      opacity: 1;
    }
  }
</style>
