---
// One page per thing I do: a short lead, pictures, a few proofs, then what I'm looking for.
import { existsSync } from 'node:fs';
import Shell from './Shell.astro';
import MediaFigure from './MediaFigure.astro';
import CopyEmail from './CopyEmail.astro';
import site from '../content/site/en.json';
import { railMedia } from '../data/media';

interface Props {
  page: 'production' | 'piano' | 'content' | 'community';
}

const { page } = Astro.props;
const p = site.pages[page];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hasCv = existsSync(`${process.cwd()}/public/${site.cv.file}`);
const media = railMedia[p.media] ?? [];
const skills = site.home.skills;
const i = skills.findIndex((s) => s.key === page);
const next = skills[(i + 1) % skills.length];
---

<Shell title={`${p.title}, ${site.name}`} description={p.description} current={`${page}/`}>
  <header class="lead">
    <h1 class="lead-title">{p.title}</h1>
    <div class="lead-text">
      <p>{p.lead}</p>
      {p.lead2 && <p>{p.lead2}</p>}
    </div>
  </header>

  {
    media.length > 0 && (
      <div class="strip">
        {media.map((m) => (
          <MediaFigure media={m} strip sizes="(max-width: 52rem) 90vw, 30rem" />
        ))}
      </div>
    )
  }

  <section class="proofs" aria-labelledby="proofs-title">
    <h2 class="proofs-title" id="proofs-title">{p.proofsTitle}</h2>
    <slot />
  </section>

  <section class="close" aria-labelledby="close-title">
    <h2 class="close-title" id="close-title">{site.home.openTitle}</h2>
    <p class="close-text">{p.close}</p>
    <div class="close-actions">
      <CopyEmail email={site.email} label={site.ui.copyEmail} done={site.ui.copied} solid />
      {hasCv && <a class="button" href={`${base}${site.cv.file}`} download>{site.cv.label}</a>}
    </div>
  </section>

  <a class="next" href={`${base}${next.path}`}>
    <span class="next-label ui soft">{site.ui.next}</span>
    <span class="next-title">{next.title}</span>
  </a>
</Shell>

<style>
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    column-gap: var(--gutter);
    align-items: end;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  .lead-title {
    font-family: var(--display);
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    font-weight: 800;
    font-stretch: 118%;
    line-height: 0.9;
    letter-spacing: -0.025em;
    margin-left: -0.05em;
    text-wrap: balance;
  }

  .lead-text {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.42;
    text-wrap: pretty;
  }

  .lead-text p + p {
    margin-top: 0.6em;
    color: var(--ink-soft);
  }

  @media (max-width: 52rem) {
    .lead {
      grid-template-columns: 1fr;
      row-gap: 1.5rem;
    }
  }

  .strip {
    --strip: 22rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 36rem) {
    .strip {
      --strip: 16rem;
    }
  }

  .proofs {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .proofs-title,
  .close-title {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .close {
    margin-top: clamp(4rem, 8vw, 6rem);
  }

  .close-title {
    margin-bottom: 1rem;
    padding-bottom: 0;
    border-bottom: 0;
  }

  .close-text {
    max-width: 40rem;
    font-size: var(--step-2);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .close-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }

  .next {
    display: block;
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .next-label {
    display: block;
  }

  .next-title {
    display: inline-block;
    margin-top: 0.25rem;
    font-family: var(--display);
    font-size: clamp(2rem, 4.6vw, 4rem);
    font-weight: 750;
    font-stretch: 100%;
    line-height: 0.95;
    letter-spacing: -0.02em;
    transition:
      font-stretch 420ms var(--ease-out),
      color 200ms ease;
  }

  .next:focus-visible .next-title {
    color: var(--violet);
    font-stretch: 122%;
  }

  @media (hover: hover) and (pointer: fine) {
    .next:hover .next-title {
      color: var(--violet);
      font-stretch: 122%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next-title {
      transition: color 200ms ease;
    }
  }
</style>
