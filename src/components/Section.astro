---
interface Props {
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-rail">
    <h2 class="section-title" id={`${id}-title`}>{title}</h2>
    {intro && <p class="section-intro">{intro}</p>}
  </div>
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: var(--rail) 8fr;
    column-gap: var(--gutter);
    padding-block: clamp(2.25rem, 5vw, 4rem) clamp(3rem, 7vw, 5.5rem);
    border-top: 1.5px solid var(--ink);
  }

  .section-rail {
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }

  .section-title {
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .section-intro {
    margin-top: 1rem;
    max-width: 22rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  @media (max-width: 52rem) {
    .section {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
    .section-rail {
      position: static;
    }
    .section-intro {
      max-width: 36rem;
    }
  }
</style>
