---
import type { Media } from '../data/media';
import MediaFigure from './MediaFigure.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
  media?: Media[];
}

const { id, title, intro, media = [] } = Astro.props;
const paragraphs = (intro ?? '').split(/\n\s*\n/).filter(Boolean);
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-rail">
    <h2 class="section-title" id={`${id}-title`}>{title}</h2>
    {paragraphs.map((p) => <p class="section-intro">{p}</p>)}
    {
      media.length > 0 && (
        <div class="section-media">
          {media.map((m) => (
            <MediaFigure media={m} sizes="(max-width: 52rem) 100vw, 24rem" />
          ))}
        </div>
      )
    }
  </div>
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: var(--rail) 8fr;
    column-gap: var(--gutter);
    padding-block: clamp(2.25rem, 5vw, 4rem) clamp(3rem, 7vw, 5.5rem);
    border-top: 1.5px solid var(--ink);
  }

  .section-rail {
    align-self: start;
  }

  .section-title {
    font-family: var(--display);
    font-size: var(--step-3);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .section-intro + .section-intro {
    margin-top: 0.6em;
  }

  .section-media {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
    max-width: 22rem;
  }

  .section-intro {
    margin-top: 1rem;
    max-width: 22rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  @media (max-width: 52rem) {
    .section {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
    .section-intro {
      max-width: 36rem;
    }
    .section-media {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      max-width: 24rem;
    }
  }
</style>
