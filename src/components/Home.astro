---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import Entry from './Entry.astro';
import SocietyLog from './SocietyLog.astro';
import Contact from './Contact.astro';
import { railMedia } from '../data/media';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const site = (await import(`../content/site/${lang}.json`)).default;
const ui = site.ui;

// The society log reads like a story: oldest first, Notion's Order breaks ties.
// Files sit in a folder per language: entries/en/..., log/en/...
const inLang = (id: string) => id.startsWith(`${lang}/`);

const entries = (await getCollection('entries', (e) => inLang(e.id) && !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.sortDate.valueOf() - a.data.sortDate.valueOf(),
);
const bySection = (s: string) => entries.filter((e) => e.data.section === s);

const log = (await getCollection('log', (e) => inLang(e.id) && !e.data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.data.date.valueOf() - b.data.date.valueOf(),
);

const s = site.sections;

// Optional sub-categories per section, set in en.json ("groups").
// An entry not listed falls into the last group, so new Notion rows always show.
type Group = { title: string; items: string[] };
const grouped = (key: string) => {
  const items = bySection(key);
  const groups: Group[] = (s as Record<string, { groups?: Group[] }>)[key]?.groups ?? [];
  if (!groups.length) return [{ title: '', items }];
  const listed = new Set(groups.flatMap((g) => g.items));
  return groups
    .map((g, i) => ({
      title: g.title,
      items: items
        .filter((e) => (i === groups.length - 1 && !listed.has(e.data.title)) || g.items.includes(e.data.title))
        .sort((a, b) => {
          const ia = g.items.indexOf(a.data.title);
          const ib = g.items.indexOf(b.data.title);
          return (ia < 0 ? 999 : ia) - (ib < 0 ? 999 : ib);
        }),
    }))
    .filter((g) => g.items.length > 0);
};
const year = new Date().getFullYear();
---

<Base lang={lang} title={site.title} description={site.description} name={site.name} socials={site.socials}>
  <a class="skip-link" href="#main">{ui.skip}</a>
  <div class="page">
    <Hero site={site} />

    <main id="main">
      {
        (['production', 'piano', 'social'] as const).map((key) => (
          <Section id={key} title={s[key].title} intro={s[key].intro} media={railMedia[key]}>
            {grouped(key).map((g) => (
              <>
                {g.title && <h3 class="subhead">{g.title}</h3>}
                {g.items.map((entry) => (
                  <Entry entry={entry} ui={ui} />
                ))}
              </>
            ))}
          </Section>
        ))
      }

      {
        log.length > 0 && (
          <Section id="society" title={s.society.title} intro={s.society.intro} media={railMedia.society}>
            <SocietyLog items={log} lang={lang} />
          </Section>
        )
      }

      {
        bySection('education').length > 0 && (
          <Section id="education" title={s.education.title} intro={s.education.intro} media={railMedia.education}>
            {bySection('education').map((entry) => (
              <Entry entry={entry} ui={ui} compact />
            ))}
          </Section>
        )
      }

      <Section id="also" title={s.also.title} intro={s.also.intro} media={railMedia.also}>
        {grouped('also').map((g) => (
          <>
            {g.title && <h3 class="subhead">{g.title}</h3>}
            {g.items.map((entry) => (
              <Entry entry={entry} ui={ui} compact />
            ))}
          </>
        ))}
      </Section>

      <Section id="contact" title={s.contact.title} intro={s.contact.intro}>
        <Contact site={site} />
      </Section>
    </main>

    <footer class="footer ui soft">
      <p>© {year} {site.name}</p>
      <p>{site.artistName}</p>
    </footer>
  </div>
</Base>

<style>
  .subhead {
    margin: clamp(2.75rem, 5vw, 3.75rem) 0 1.5rem;
    padding-left: calc(var(--dates) + 1.5rem);
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 700;
    font-stretch: 112%;
    color: var(--ink-soft);
  }

  .section-content > .subhead:first-child,
  :global(.section-content) > .subhead:first-child {
    margin-top: 0;
  }

  @media (max-width: 36rem) {
    .subhead {
      padding-left: 0;
    }
  }

  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--rule);
  }
</style>
