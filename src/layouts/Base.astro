---
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  lang: string;
  title: string;
  description: string;
  name: string;
  socials: { label: string; url: string }[];
}

const { lang, title, description, name, socials } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(base, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  alternateName: 'MAXRØ',
  jobTitle: 'Pianist and producer',
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Westminster' },
  url: canonical.href,
  sameAs: socials.map((s) => s.url),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#f5f4f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121018" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name}, MAXRØ`} />
    <meta property="og:locale" content="en_GB" />
    <meta property="profile:first_name" content="Maximilien" />
    <meta property="profile:last_name" content="Roi" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
